{
  "name": "bluepy",
  "main": "./workers/assets.js",
  "compatibility_date": "2025-06-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/feedback",
      "/oauth-client-metadata.json",
      "/version.json",
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "FEEDBACK_RATE_LIMITER", "class_name": "FeedbackRateLimiter" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FeedbackRateLimiter"] },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "bluepy": {
      "name": "bluepy",
      "durable_objects": {
        "bindings": [
          {
            "name": "FEEDBACK_RATE_LIMITER",
            "class_name": "FeedbackRateLimiter",
          },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["FeedbackRateLimiter"] },
      ],
    },
    "dev": {
      "name": "bluepy-dev",
      "main": "./workers/assets.js",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/feedback",
          "/oauth-client-metadata.json",
          "/version.json",
        ],
      },
      "routes": [
        {
          "pattern": "dev.bluepy.social",
          "custom_domain": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "FEEDBACK_RATE_LIMITER",
            "class_name": "FeedbackRateLimiter",
          },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["FeedbackRateLimiter"] },
      ],
    },
    "preview": {
      "name": "bluepy-preview",
      "main": "./workers/assets.js",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/feedback",
          "/oauth-client-metadata.json",
          "/version.json",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "FEEDBACK_RATE_LIMITER",
            "class_name": "FeedbackRateLimiter",
          },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["FeedbackRateLimiter"] },
      ],
    },
  },
}
