{
  "name": "bluepy",
  "compatibility_date": "2025-06-18",
  "assets": {
    "directory": "./dist",
  },
  "env": {
    "bluepy": {
      "name": "bluepy",
    },
    "dev": {
      "name": "bluepy-dev",
      "routes": [
        {
          "pattern": "dev.bluepy.social",
          "custom_domain": true,
        },
      ],
    },
  },
}
