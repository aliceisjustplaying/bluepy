{
  "name": "bluepy",
  "compatibility_date": "2025-06-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "bluepy": {
      "name": "bluepy",
    },
    "dev": {
      "name": "bluepy-dev",
      "main": "./workers/dev-assets.js",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/oauth-client-metadata.json",
          "/version.json",
        ],
      },
      "routes": [
        {
          "pattern": "dev.bluepy.social",
          "custom_domain": true,
        },
      ],
    },
  },
}
