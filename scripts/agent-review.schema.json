{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["clean", "needs_fix"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": ["severity", "file", "line", "summary", "recommendation"]
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["verdict", "summary", "findings", "residual_risks"]
}
